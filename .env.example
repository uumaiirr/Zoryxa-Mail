# ─── CEO Mail Agent — environment variables ───────────────────────────────────
# Copy the values into Netlify → Site settings → Environment variables.
# Never commit a filled-in copy of this file.

# ── LLM provider (free tier) ──────────────────────────────────────────────────
# 'gemini' (Google AI Studio, free) or 'groq' (Groq Cloud, free). Swappable any time.
LLM_PROVIDER=gemini

# Google AI Studio key — free, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model is overridable; leave blank to use the built-in default.
GEMINI_MODEL=

# Groq key (only needed if LLM_PROVIDER=groq): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=

# ── Gmail OAuth (bridge account) ──────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI must be: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase (free tier) ──────────────────────────────────────────────────────
# Project → Settings → API. The service-role key is server-only; it never
# reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── App security ──────────────────────────────────────────────────────────────
# Sign-in is "Continue with Google" — no passwords. RECOMMENDED: list who may
# sign in (comma-separated). Empty = anyone with the link can create their own
# workspace (they still can't see anyone else's mail, but they'd share your
# free AI quota).
ALLOWED_LOGIN_EMAILS=
# Random secrets. Generate each with:  openssl rand -hex 32
# (or in PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) }) )
SESSION_SECRET=
# MUST be exactly 64 hex characters (32 bytes) — encrypts the Gmail refresh token at rest.
TOKEN_ENCRYPTION_KEY=
# Shared secret the scheduler sends as the `x-cron-secret` header.
CRON_SECRET=

# ── Real-time arrival (optional but recommended) ──────────────────────────────
# Cloud Pub/Sub topic for Gmail push notifications, so mail appears in the app
# within seconds of landing. Format: projects/YOUR_PROJECT_ID/topics/gmail-push
# Leave blank to rely on the hourly scheduler + on-open sync instead.
GMAIL_PUSH_TOPIC=

# ── Site & mail routing ───────────────────────────────────────────────────────
# Your deployed URL, no trailing slash, e.g. https://ceo-mail.netlify.app
SITE_URL=
# Where the morning digest is emailed (the app owner's own inbox).
# The From address on outgoing mail is configured PER ACCOUNT inside the app
# (Settings → Mail accounts → "Send as").
DIGEST_TO=walid@dubaiconsultancy.ae
